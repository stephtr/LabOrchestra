<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AssemblyName>LabOrchestra.Plugins.Demo</AssemblyName>
		<!-- built straight into the plugins folder of the server -->
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<OutputPath>$(MSBuildThisFileDirectory)../../LabOrchestra.Server/bin/$(Configuration)/net11.0/plugins/</OutputPath>
		<GenerateDependencyFile>true</GenerateDependencyFile>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="../../LabOrchestra.Sdk/LabOrchestra.Sdk.csproj">
			<Private>false</Private>
		</ProjectReference>
	</ItemGroup>

</Project>
